modules = ["web", "nodejs-20", "bash", "python-3.11"]
[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "libxcrypt", "mupdf", "openjpeg", "qpdf", "swig", "xcbuild"]

[agent]
expertMode = true

[userenv]

[userenv.development]
COOKIE_SAMESITE = "none"
FRAME_ANCESTORS = "'self' https://replit.com https://*.replit.com https://*.replit.dev"

[userenv.shared]
COACH_MODEL = "gemini:gemini-3.1-flash-lite"
LLM_FAST_MODEL = "gemini-3.1-flash-lite"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd src && uv run --extra ai uvicorn server.api:app --host 0.0.0.0 --port 5000 --proxy-headers --forwarded-allow-ips '*'"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
