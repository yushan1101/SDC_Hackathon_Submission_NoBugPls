# Copy this file to .env (local) or add these to Replit Secrets. Never commit your real .env file.
PROJECT_NAME="AiversePulse Enterprise"
# RunPod serverless endpoint for GPU jobs (runpod/handler.py): training STF-KAN / the requirement model, batch embeddings
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# LLM agents (Coach explanation, ambiguous routing, resume skill proposals) stay OFF unless key + model are set.
# Cheap default: Gemini 3.1 Flash-Lite ($0.25 in / $1.50 out per 1M tokens; ai.google.dev/gemini-api/docs/pricing, Oct 2026)
GEMINI_API_KEY=
LLM_FAST_MODEL=gemini-3.1-flash-lite
LLM_COMPLEX_MODEL=
# opt-in: send the REDACTED resume (name/contacts/pronouns removed) to the LLM to propose extra skills
LLM_RESUME=false
# From the provider's current price sheet, to estimate cost; 0 = not estimated
LLM_USD_PER_1M_INPUT=0.25
LLM_USD_PER_1M_OUTPUT=1.50
# Paths default to src/data/ and src/artifacts/; override only if you keep them elsewhere
# DATABASE_PATH=src/data/audit.sqlite3
# CHROMA_PATH=src/data/chroma
# Live STF-KAN outlook on CPU: folder with stf_kan_best.pt + artifact_manifest.json, and the checksum-checked input
# OUTLOOK_ARTIFACT_DIR=src/artifacts/onet
# OUTLOOK_HISTORY_PATH=src/data/training/onet_history.csv
# Empty = in-process FastMCP; or run `python -m mcp_server.server --http` and set http://localhost:8765/mcp
MCP_URL=
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_TIMEOUT_S=20
LLM_TIMEOUT_S=30
# Web server bind (src/main.py); hosts like Replit set PORT themselves
HOST=0.0.0.0
PORT=8600
# Link shown on STF-KAN outlook evidence (model card / requirements trace)
MODEL_CARD_URL=https://github.com/yushan1101/SDC_Hackathon_Submission_NoBugPls/blob/devby/docs/requirements_trace.md
MAX_UPLOAD_ROWS=5000
MAX_TEAM_SIZE=500
LOG_LEVEL=INFO
# Separate frontend deploy: allowed frontend origins (comma-separated) and the session cookie policy
CORS_ORIGINS=
COOKIE_SAMESITE=strict
# Refresh the daily AI-trend board inside the web server (HN, arXiv, job boards)
SIGNALS_DAILY=true
