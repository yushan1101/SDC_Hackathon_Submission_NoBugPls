# Example only - never commit a populated .env
# LLM agents (Coach explanation, ambiguous routing) stay OFF unless both are set.
GEMINI_API_KEY=
LLM_FAST_MODEL=
LLM_COMPLEX_MODEL=
# Fill from the provider's current price sheet to estimate cost; 0 = not estimated
LLM_USD_PER_1M_INPUT=0
LLM_USD_PER_1M_OUTPUT=0
DATABASE_PATH=data/audit.sqlite3
CHROMA_PATH=data/chroma
FORECAST_MODEL_PATH=artifacts/stf_kan_best.pt
# Empty = in-process FastMCP; or run `python -m mcp_server.server --http` and set http://localhost:8765/mcp
MCP_URL=
MAX_UPLOAD_ROWS=5000
MAX_TEAM_SIZE=500
LOG_LEVEL=INFO
