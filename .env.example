# Copy this file to .env (local) or add these to Replit Secrets. Never commit your real .env file.
PROJECT_NAME="AiversePulse Enterprise"
# RunPod serverless endpoint for GPU jobs (runpod/handler.py): training STF-KAN / the requirement model, batch embeddings
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# LLM agents (Coach explanation, ambiguous routing, resume skill proposals) stay OFF unless key + model are set.
# Cheap default: Gemini 3.1 Flash-Lite ($0.25 in / $1.50 out per 1M tokens; ai.google.dev/gemini-api/docs/pricing, Oct 2026)
GEMINI_API_KEY=
LLM_FAST_MODEL=gemini-3.1-flash-lite
LLM_COMPLEX_MODEL=
# One OpenAI-compatible gateway for the "openai:" models below (same base URL + key for all of them)
LLM_BASE_URL=
LLM_API_KEY=
# Which model each agent uses: "openai:<model id>" (gateway above) or "gemini:<model id>". Empty = LLM_FAST_MODEL on Gemini.
# Use the exact model ids your gateway lists.
ROUTER_MODEL=gemini:gemini-3.1-flash-lite
COACH_MODEL=openai:grok-4.7
RESUME_MODEL=openai:gpt-5.6-luna
# job posts, "ask your team" and voice job drafts (HR); empty = LLM_FAST_MODEL on Gemini
RECRUITER_MODEL=
# voice input (paid plans): an audio chat model on the gateway (default), or a whisper-style model, or gemini:<model>
STT_MODEL=openai:mimo-v2.6-flash
# opt-in: send the REDACTED resume (name/contacts/pronouns removed) to the LLM to propose extra skills
LLM_RESUME=false
# From the provider's current price sheet, to estimate cost; 0 = not estimated
LLM_USD_PER_1M_INPUT=0.25
LLM_USD_PER_1M_OUTPUT=1.50
# Paths default to src/data/ and src/artifacts/; override only if you keep them elsewhere
# DATABASE_PATH=src/data/audit.sqlite3
# CHROMA_PATH=src/data/chroma
# Live STF-KAN outlook on CPU: folder with stf_kan_best.pt + artifact_manifest.json, and the checksum-checked input
# OUTLOOK_ARTIFACT_DIR=src/artifacts/onet
# OUTLOOK_HISTORY_PATH=src/data/training/onet_history.csv
# Empty = in-process FastMCP; or run `python -m mcp_server.server --http` and set http://localhost:8765/mcp
MCP_URL=
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_TIMEOUT_S=20
LLM_TIMEOUT_S=30
# Web server bind (src/main.py); hosts like Replit set PORT themselves
HOST=0.0.0.0
PORT=8600
# Link shown on STF-KAN outlook evidence (model card / requirements trace)
MODEL_CARD_URL=https://github.com/yushan1101/SDC_Hackathon_Submission_NoBugPls/blob/devby/docs/requirements_trace.md
MAX_UPLOAD_ROWS=5000
MAX_TEAM_SIZE=500
LOG_LEVEL=INFO
# Separate frontend deploy: allowed frontend origins (comma-separated) and the session cookie policy
CORS_ORIGINS=
COOKIE_SAMESITE=strict
# Refresh the daily AI-trend board inside the web server (HN, arXiv, job boards)
SIGNALS_DAILY=true
# Load the AI model and search index in the background at start-up (CI sets false)
WARM_ON_START=true

# --- Plans and payments: Stripe, test mode first (https://dashboard.stripe.com/test/apikeys). Empty = payments off ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook endpoint https://<your-site>/api/billing/webhook, events payment_intent.succeeded and payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=
CURRENCY=myr
PRICE_PRO_CENTS=1900
PRICE_TEAM_CENTS=9900
PLAN_DAYS=30
FREE_MONTHLY_BRIEFINGS=3

# --- Email (sign-up, password reset, HR invites). Empty host = no email verification ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Where links in emails point (e.g. https://sdc.olgtx.com); empty = the address the request came in on
PUBLIC_URL=
# Contact shown on the Terms and Privacy pages
SUPPORT_EMAIL=

# --- Hiring plugins (HR -> Hiring plugins). Telegram, Discord and Slack need nothing here.
# LinkedIn/Facebook/X: create an app on each developer site and register this redirect URL in it:
#   <PUBLIC_URL>/api/plugins/oauth/<linkedin|facebook|x>/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202509
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
X_CLIENT_ID=
X_CLIENT_SECRET=
# Fernet key for stored platform tokens (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# empty = a key file beside the database
PLUGIN_SECRET_KEY=
